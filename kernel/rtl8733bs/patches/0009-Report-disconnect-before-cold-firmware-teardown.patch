From 8b35ccbf580a2a2b3358b2ba51940b1c9b033ae7 Mon Sep 17 00:00:00 2001
From: Q2 source preparation <noreply@localhost>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] Report disconnect before cold firmware teardown

---
 os_dep/linux/os_intfs.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/os_dep/linux/os_intfs.c b/os_dep/linux/os_intfs.c
index 2dfb9f3..1ba6814 100644
--- a/os_dep/linux/os_intfs.c
+++ b/os_dep/linux/os_intfs.c
@@ -4914,6 +4914,7 @@ void rtw_dev_unload(PADAPTER padapter)
 int rtw_suspend_free_assoc_resource(_adapter *padapter)
 {
 	struct mlme_priv *pmlmepriv = &padapter->mlmepriv;
+	struct pwrctrl_priv *pwrpriv = adapter_to_pwrctl(padapter);
 	struct mlme_ext_priv *pmlmeext = &padapter->mlmeextpriv;
 	struct mlme_ext_info *pmlmeinfo = &(pmlmeext->mlmext_info);
 #ifdef CONFIG_P2P
@@ -4922,7 +4923,13 @@ int rtw_suspend_free_assoc_resource(_adapter *padapter)
 
 	RTW_INFO("==> "FUNC_ADPT_FMT" entry....\n", FUNC_ADPT_ARG(padapter));
 
-	if (rtw_chk_roam_flags(padapter, RTW_ROAM_ON_RESUME)) {
+	/* Cold teardown destroys firmware association and keys. Report the
+	 * disconnect to cfg80211/supplicant instead of claiming a retained roam.
+	 * Keep the existing roaming behavior for firmware-retaining WoW paths.
+	 */
+	if (!pwrpriv->wowlan_mode && !pwrpriv->wowlan_ap_mode)
+		rtw_set_to_roam(padapter, 0);
+	else if (rtw_chk_roam_flags(padapter, RTW_ROAM_ON_RESUME)) {
 		if (check_fwstate(pmlmepriv, WIFI_STATION_STATE)
 			&& check_fwstate(pmlmepriv, WIFI_ASOC_STATE)
 			#ifdef CONFIG_P2P
