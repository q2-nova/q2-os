+ *   6.14 get_tx_power gains link_id
+ *   6.17 set_wiphy_params, set_tx_power and get_tx_power gain radio_idx
+ *   7.1  key and station operations take the wireless_dev
+ *   7.3  remain_on_channel and mgmt_tx receive the cookie cfg80211 assigned
+ * Thin forwarders keep the vendor implementations unchanged.
+ */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+#define RTW_CFG80211_WDEV_OP(fn) fn##_wdev
+static int cfg80211_rtw_add_key_wdev(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int link_id, u8 key_index, bool pairwise,
+	const u8 *mac_addr, struct key_params *params)
+{
+	return cfg80211_rtw_add_key(wiphy, wdev->netdev, link_id, key_index,
+				    pairwise, mac_addr, params);
+}
+
+static int cfg80211_rtw_get_key_wdev(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int link_id, u8 key_index, bool pairwise,
+	const u8 *mac_addr, void *cookie,
+	void (*callback)(void *cookie, struct key_params *))
+{
+	return cfg80211_rtw_get_key(wiphy, wdev->netdev, link_id, key_index,
+				    pairwise, mac_addr, cookie, callback);
+}
+
+static int cfg80211_rtw_del_key_wdev(struct wiphy *wiphy,
