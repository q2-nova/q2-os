 	.set_pmksa = cfg80211_rtw_set_pmksa,
@@ -10678,10 +10829,10 @@ static struct cfg80211_ops rtw_cfg80211_ops = {
 	.set_mac_acl = cfg80211_rtw_set_mac_acl,
 #endif
 
-	.add_station = cfg80211_rtw_add_station,
