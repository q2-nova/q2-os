+/*
+ * cfg80211 API compatibility helpers
+ *
+ * - Linux v6.9 removed the punct_bitmap argument of
+ *   cfg80211_ch_switch_notify() and cfg80211_ch_switch_started_notify().
+ * - Linux v6.12 moved the DFS/CAC state of struct wireless_dev into
+ *   links[] and added a link_id argument to cfg80211_cac_event().
+ *
+ * Kernels older than v6.9 keep using the exact calls the driver used before.
+ */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 9, 0))
+#define rtw_cfg80211_ch_switch_notify_compat(dev, chdef, link_id, punct_bitmap) \
+	do { \
+		(void)(punct_bitmap); \
+		cfg80211_ch_switch_notify(dev, chdef, link_id); \
+	} while (0)
+#define rtw_cfg80211_ch_switch_started_notify_compat(dev, chdef, link_id, count, quiet, punct_bitmap) \
+	do { \
+		(void)(punct_bitmap); \
+		cfg80211_ch_switch_started_notify(dev, chdef, link_id, count, quiet); \
+	} while (0)
+#else
+#define rtw_cfg80211_ch_switch_notify_compat(dev, chdef, link_id, punct_bitmap) \
+	cfg80211_ch_switch_notify(dev, chdef, link_id, punct_bitmap)
+#define rtw_cfg80211_ch_switch_started_notify_compat(dev, chdef, link_id, count, quiet, punct_bitmap) \
+	cfg80211_ch_switch_started_notify(dev, chdef, link_id, count, quiet, punct_bitmap)
+#endif
+
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+#define rtw_wdev_cac_started(wdev) ((wdev)->links[0].cac_started)
+#define rtw_cfg80211_cac_event_compat(netdev, chdef, event, gfp) \
+	cfg80211_cac_event(netdev, chdef, event, gfp, 0)
+#else
+#define rtw_wdev_cac_started(wdev) ((wdev)->cac_started)
+#define rtw_cfg80211_cac_event_compat(netdev, chdef, event, gfp) \
+	cfg80211_cac_event(netdev, chdef, event, gfp)
+#endif
+
+/* Linux v7.1: cfg80211_new_sta() and cfg80211_del_sta() take the wireless_dev. */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0))
+#define rtw_cfg80211_sta_dev(ndev) ((ndev)->ieee80211_ptr)
+#else
+#define rtw_cfg80211_sta_dev(ndev) (ndev)
+#endif
+
 #if !defined(CONFIG_P2P) && RTW_P2P_GROUP_INTERFACE
 	#error "RTW_P2P_GROUP_INTERFACE can't be enabled when CONFIG_P2P is disabled\n"
 #endif
