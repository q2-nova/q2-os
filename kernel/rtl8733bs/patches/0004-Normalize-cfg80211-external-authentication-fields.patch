From 394cd71a4bb4f0c8d7e0fcf44ebafb255da35418 Mon Sep 17 00:00:00 2001
From: Q2 Navidrome contributors <noreply@localhost>
Date: Tue, 3 Nov 2026 00:05:57 -0600
Subject: [PATCH] Normalize cfg80211 external authentication fields and
 optional PMKID

Linux 5.1 changed cfg80211's inline PMKID into a nullable pointer. On the
actual MIPS o32 ABI the pointer starts at byte 52, whereas the vendor inline
array starts at byte 50. Casting the structures can cache pointer/neighbor
bytes rather than the key identifier. Normalize each field, copy only a
present PMKID and skip PMKSA insertion when it is absent. Preserve the vendor
command's existing wire offsets and explicitly mark its inline PMKID valid.

This patch is opt-in through prepare.py --sae-external-auth until the generated
radio qualification passes; it does not silently replace the normal driver.

---
 core/rtw_mlme_ext.c           |  1 +
 os_dep/linux/ioctl_cfg80211.c | 35 +++++++++++++++++++++++++++++------
 os_dep/linux/ioctl_cfg80211.h |  1 +
 3 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/core/rtw_mlme_ext.c b/core/rtw_mlme_ext.c
index c8c6155..3258228 100755
--- a/core/rtw_mlme_ext.c
+++ b/core/rtw_mlme_ext.c
@@ -16311,6 +16311,7 @@ void rtw_set_external_auth_status(_adapter *padapter,
 	params.key_mgmt_suite = RTW_GET_BE32((u8 *)data + 58);
 	params.status = RTW_GET_BE16((u8 *)data + 62);
 	_rtw_memcpy(&params.pmkid, (u8 *)data + 64, PMKID_LEN);
+	params.pmkid_valid = 1;
 
 	rtw_cfg80211_external_auth_status(wiphy, dev, &params);
 #endif /* CONFIG_IOCTL_CFG80211 */
diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
index 3dfd078..01d28ea 100644
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -10439,15 +10439,38 @@ static int rtw_hostapd_acs_dump_survey(struct wiphy *wiphy, struct net_device *n
 
 #if (KERNEL_VERSION(4, 17, 0) <= LINUX_VERSION_CODE) \
     || defined(CONFIG_KERNEL_PATCH_EXTERNAL_AUTH)
+/* cfg80211 changed PMKID from an inline array to a nullable pointer in 5.1.
+ * Normalize fields explicitly: the vendor structure is not a kernel ABI.
+ */
+static void rtw_external_auth_from_cfg80211(struct rtw_external_auth_params *dst,
+	const struct cfg80211_external_auth_params *src)
+{
+	_rtw_memset(dst, 0, sizeof(*dst));
+	dst->action = (enum external_auth_action)src->action;
+	_rtw_memcpy(dst->bssid, src->bssid, ETH_ALEN);
+	dst->ssid = src->ssid;
+	dst->key_mgmt_suite = src->key_mgmt_suite;
+	dst->status = src->status;
+#if (KERNEL_VERSION(5, 1, 0) <= LINUX_VERSION_CODE)
+	if (src->pmkid) {
+		_rtw_memcpy(dst->pmkid, src->pmkid, PMKID_LEN);
+		dst->pmkid_valid = 1;
+	}
+#else
+	_rtw_memcpy(dst->pmkid, src->pmkid, PMKID_LEN);
+	dst->pmkid_valid = 1;
+#endif
+}
+
 int cfg80211_rtw_external_auth(struct wiphy *wiphy, struct net_device *dev,
 	struct cfg80211_external_auth_params *params)
 {
-	PADAPTER padapter = (_adapter *)rtw_netdev_priv(dev);
+	struct rtw_external_auth_params normalized;
 
 	RTW_INFO(FUNC_NDEV_FMT"\n", FUNC_NDEV_ARG(dev));
 
-	rtw_cfg80211_external_auth_status(wiphy, dev,
-		(struct rtw_external_auth_params *)params);
+	rtw_external_auth_from_cfg80211(&normalized, params);
+	rtw_cfg80211_external_auth_status(wiphy, dev, &normalized);
 
 	return 0;
 }
@@ -10484,9 +10507,9 @@ void rtw_cfg80211_external_auth_status(struct wiphy *wiphy, struct net_device *d
 		psta->state |= WIFI_FW_AUTH_SUCCESS;
 		psta->expire_to = padapter->stapriv.assoc_to;
 
-		/* ToDo: Kernel v5.1 pmkid is pointer */
-		/* RTW_INFO_DUMP("PMKID:", params->pmkid, PMKID_LEN); */
-		_rtw_set_pmksa(dev, params->bssid, params->pmkid);
+		/* cfg80211 may omit PMKID; never cache pointer bytes or zero padding. */
+		if (params->pmkid_valid)
+			_rtw_set_pmksa(dev, params->bssid, params->pmkid);
 
 		_enter_critical_bh(&psta->lock, &irqL);
 		if ((psta->auth_len != 0) && (psta->pauth_frame != NULL)) {
diff --git a/os_dep/linux/ioctl_cfg80211.h b/os_dep/linux/ioctl_cfg80211.h
index 6965e3a..0e426d1 100755
--- a/os_dep/linux/ioctl_cfg80211.h
+++ b/os_dep/linux/ioctl_cfg80211.h
@@ -270,6 +270,7 @@ struct rtw_external_auth_params {
 	unsigned int key_mgmt_suite;
 	u16 status;
 	u8 pmkid[PMKID_LEN];
+	u8 pmkid_valid; /* internal state, not part of the vendor wire format */
 };
 
 bool rtw_cfg80211_is_connect_requested(_adapter *adapter);
-- 
2.55.0

