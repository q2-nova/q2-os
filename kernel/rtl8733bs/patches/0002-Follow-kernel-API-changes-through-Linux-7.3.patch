From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:24:56 -0600
Subject: [PATCH 2/3] Follow kernel API changes through Linux 7.3

Each version gate was checked against the tagged release's headers:
- 6.2: timer_delete() and timer_delete_sync(); the del_timer names are
  gone from 6.15.
- 6.16: timer_container_of() replaces from_timer().
- 6.13: MODULE_IMPORT_NS() takes a string.
- 7.2: strncpy() is removed; keep a local copy with identical
  copy-and-pad semantics.
- The kernel's crypto/sha2.h now declares hmac_sha256() with a different
  signature; rename the driver's own copy, which nothing else calls.
---
 core/crypto/sha256.c          |  2 +-
 core/crypto/sha256.h          |  3 ++-
 include/osdep_service_linux.h | 30 +++++++++++++++++++++++++++++-
 os_dep/osdep_service.c        |  4 +++-
 4 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/core/crypto/sha256.c b/core/crypto/sha256.c
index ea5d9e3..b2e63d7 100755
--- a/core/crypto/sha256.c
+++ b/core/crypto/sha256.c
@@ -97,7 +97,7 @@ int hmac_sha256_vector(const u8 *key, size_t key_len, size_t num_elem,
  * @mac: Buffer for the hash (32 bytes)
  * Returns: 0 on success, -1 on failure
  */
-int hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
+int rtw_hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
 		size_t data_len, u8 *mac)
 {
 	return hmac_sha256_vector(key, key_len, 1, &data, &data_len, mac);
diff --git a/core/crypto/sha256.h b/core/crypto/sha256.h
index 5219022..b17206d 100755
--- a/core/crypto/sha256.h
+++ b/core/crypto/sha256.h
@@ -13,7 +13,8 @@
 
 int hmac_sha256_vector(const u8 *key, size_t key_len, size_t num_elem,
 		       const u8 *addr[], const size_t *len, u8 *mac);
-int hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
+/* Renamed: Linux 6.16+ crypto/sha2.h declares a different hmac_sha256(). */
+int rtw_hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
 		size_t data_len, u8 *mac);
 int sha256_prf(const u8 *key, size_t key_len, const char *label,
 	       const u8 *data, size_t data_len, u8 *buf, size_t buf_len);
diff --git a/include/osdep_service_linux.h b/include/osdep_service_linux.h
index 9a39434..ba68de1 100755
--- a/include/osdep_service_linux.h
+++ b/include/osdep_service_linux.h
@@ -24,6 +24,24 @@
 #include <linux/slab.h>
 #include <linux/module.h>
 #include <linux/namei.h>
+
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0))
+/* Linux 7.2 removed strncpy(); keep its exact copy-and-pad semantics. */
+static inline char *rtw_strncpy(char *dest, const char *src, size_t count)
+{
+	char *tmp = dest;
+
+	while (count) {
+		*tmp = *src;
+		if (*tmp)
+			src++;
+		tmp++;
+		count--;
+	}
+	return dest;
+}
+#define strncpy(dest, src, count) rtw_strncpy(dest, src, count)
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 5))
 	#include <linux/kref.h>
 #endif
@@ -371,7 +389,9 @@ static inline void timer_hdl(struct timer_list *in_timer)
 static inline void timer_hdl(unsigned long cntx)
 #endif
 {
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 14, 0))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0))
+	_timer *ptimer = timer_container_of(ptimer, in_timer, timer);
+#elif (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 14, 0))
 	_timer *ptimer = from_timer(ptimer, in_timer, timer);
 #else
 	_timer *ptimer = (_timer *)cntx;
@@ -406,12 +426,20 @@ __inline static void _set_timer(_timer *ptimer, u32 delay_time)
 
 __inline static void _cancel_timer(_timer *ptimer, u8 *bcancelled)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0))
+	*bcancelled = timer_delete_sync(&ptimer->timer) == 1 ? 1 : 0;
+#else
 	*bcancelled = del_timer_sync(&ptimer->timer) == 1 ? 1 : 0;
+#endif
 }
 
 __inline static void _cancel_timer_async(_timer *ptimer)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0))
+	timer_delete(&ptimer->timer);
+#else
 	del_timer(&ptimer->timer);
+#endif
 }
 
 static inline void _init_workitem(_workitem *pwork, void *pfunc, void *cntx)
diff --git a/os_dep/osdep_service.c b/os_dep/osdep_service.c
index 320c766..3b59ac1 100644
--- a/os_dep/osdep_service.c
+++ b/os_dep/osdep_service.c
@@ -2620,7 +2620,9 @@ static const char *get_file_name_from_path(const char *path)
 * @param mode please refer to linux document
 * @return Linux specific error code
 */
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 153))
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0))
+MODULE_IMPORT_NS("VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver");
+#elif (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 153))
 MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
 #endif
 static int openFile(struct file **fpp, const char *path, int flag, int mode)
