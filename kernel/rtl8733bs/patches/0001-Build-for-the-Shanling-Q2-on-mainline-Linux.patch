From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:24:56 -0600
Subject: [PATCH 1/3] Build for the Shanling Q2 on mainline Linux

Add a Q2 platform block: little-endian MIPS, cfg80211 with station
events and concurrent mode. Board power comes from the device tree
(MSC1 vmmc-supply and mmc-pwrseq-simple), so the generic platform_ops
hooks stay empty. PHY parameter files load from /lib/firmware/rtlwifi/,
where stock firmware kept them in /firmware/rtlwifi/.

Match the stock rtl8733bs.ko's dump_drv_cfg option strings: enable power
saving and disable MBO (802.11k/v/r), which the stock module lacks. Disable
the bridge NAT extension; the player never bridges wlan0 and its PPPoE
code uses fields Linux hides from kernel builds.

Linux 6.15 removed kbuild's EXTRA_CFLAGS, so pass the collected flags
through ccflags-y after all of them are set.
---
 Makefile | 36 +++++++++++++++++++++++++++++++-----
 1 file changed, 31 insertions(+), 5 deletions(-)

diff --git a/Makefile b/Makefile
index 361ec67..f19ea8b 100644
--- a/Makefile
+++ b/Makefile
@@ -73,7 +73,7 @@ CONFIG_AP_MODE = y
 CONFIG_ECSA = y
 CONFIG_P2P = y
 CONFIG_MP_INCLUDED = y
-CONFIG_POWER_SAVING = n
+CONFIG_POWER_SAVING = y
 CONFIG_IPS_MODE = default
 CONFIG_LPS_MODE = default
 CONFIG_USB_AUTOSUSPEND = n
@@ -122,7 +122,8 @@ CONFIG_RTW_EDCCA_MODE_SEL = NORMAL
 CONFIG_SIGNAL_SCALE_MAPPING = n
 CONFIG_80211W = y
 CONFIG_REDUCE_TX_CPU_LOADING = n
-CONFIG_BR_EXT = y
+# Q2: no bridging; its PPPoE code uses fields Linux hides from kernel builds.
+CONFIG_BR_EXT = n
 CONFIG_TDLS = n
 CONFIG_WIFI_MONITOR = n
 CONFIG_MCC_MODE = n
@@ -136,7 +137,8 @@ CONFIG_ICMP_VOQ = n
 CONFIG_IP_R_MONITOR = n #arp VOQ and high rate
 # user priority mapping rule : tos, dscp
 CONFIG_RTW_UP_MAPPING_RULE = tos
-CONFIG_RTW_MBO = y
+# Q2: the stock rtl8733bs.ko has no MBO/802.11k/v/r code.
+CONFIG_RTW_MBO = n
 CONFIG_WAKE_ON_BT = n
 CONFIG_HIGH_PRIORITY_CMD_THREAD = n
 CONFIG_RTW_DISABLE_HW_PDN = n
@@ -197,7 +199,12 @@ CONFIG_SECURE_DMA = n
 CONFIG_SECURE_DMA_MEM_ADDR = 0
 CONFIG_SECURE_DMA_MEM_SIZE = 3686400
 ###################### Platform Related #######################
-CONFIG_PLATFORM_I386_PC = y
+CONFIG_PLATFORM_I386_PC = n
+CONFIG_PLATFORM_SHANLING_Q2 = y
+ifeq ($(CONFIG_PLATFORM_SHANLING_Q2), y)
+# Stock firmware keeps PHY_REG_PG.txt and TXPWR_LMT.txt in /firmware/rtlwifi/.
+REALTEK_CONFIG_PATH ?= /lib/firmware/rtlwifi/
+endif
 CONFIG_PLATFORM_ANDROID_X86 = n
 CONFIG_PLATFORM_ANDROID_INTEL_X86 = n
 CONFIG_PLATFORM_JB_X86 = n
@@ -1212,7 +1219,8 @@ endif
 ifeq ($(CONFIG_LOAD_PHY_PARA_FROM_FILE), y)
 EXTRA_CFLAGS += -DCONFIG_LOAD_PHY_PARA_FROM_FILE
 #EXTRA_CFLAGS += -DREALTEK_CONFIG_PATH_WITH_IC_NAME_FOLDER
-EXTRA_CFLAGS += -DREALTEK_CONFIG_PATH=\"/lib/firmware/\"
+REALTEK_CONFIG_PATH ?= /lib/firmware/
+EXTRA_CFLAGS += -DREALTEK_CONFIG_PATH=\"$(REALTEK_CONFIG_PATH)\"
 endif
 
 ifeq ($(CONFIG_TXPWR_BY_RATE), n)
@@ -1477,6 +1485,21 @@ ifeq ($(CONFIG_RTW_DISABLE_HW_PDN), y)
 EXTRA_CFLAGS += -DCONFIG_RTW_DISABLE_HW_PDN
 endif
 
+# Shanling Q2 (Ingenic X2000) on the mainline kernel. Board power comes
+# from the device tree (MSC1 vmmc-supply and mmc-pwrseq-simple), so the
+# generic platform_ops.c hooks stay empty. Options follow the stock
+# rtl8733bs.ko's dump_drv_cfg strings: cfg80211, concurrent mode, power
+# saving and PHY parameter files. Pass KSRC (kernel build directory),
+# ARCH=mips and CROSS_COMPILE on the make command line.
+ifeq ($(CONFIG_PLATFORM_SHANLING_Q2), y)
+EXTRA_CFLAGS += -DCONFIG_LITTLE_ENDIAN
+EXTRA_CFLAGS += -DCONFIG_IOCTL_CFG80211 -DRTW_USE_CFG80211_STA_EVENT
+EXTRA_CFLAGS += -DCONFIG_CONCURRENT_MODE
+ARCH ?= mips
+CROSS_COMPILE ?= mipsel-linux-gnu-
+KSRC ?= /lib/modules/$(KVER)/build
+endif
+
 ifeq ($(CONFIG_PLATFORM_I386_PC), y)
 EXTRA_CFLAGS += -DCONFIG_LITTLE_ENDIAN -DCONFIG_USB_INBAND
 EXTRA_CFLAGS += -DCONFIG_IOCTL_CFG80211 -DRTW_USE_CFG80211_STA_EVENT
@@ -2638,6 +2661,9 @@ ifeq ($(CONFIG_RTL8723B), y)
 $(MODULE_NAME)-$(CONFIG_MP_INCLUDED)+= core/rtw_bt_mp.o
 endif
 
+# Linux 6.15 removed kbuild's EXTRA_CFLAGS; pass the collected flags.
+ccflags-y += $(EXTRA_CFLAGS)
+
 obj-$(CONFIG_RTL8733BS) := $(MODULE_NAME).o
 
 else
