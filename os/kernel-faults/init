#!/bin/sh
# Init of the fault kernel's initramfs (os/kernel_faults.py): a root shell on
# UART0 for the emulator harness. The console stays on UART3.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin
mount -t devtmpfs none /dev
mount -t proc none /proc
mount -t sysfs none /sys
mount -t tmpfs -o mode=1777,size=16m none /tmp
mkdir -p /mnt/card
hostname q2-kernel-faults
echo "Q2_FAULT_SHELL_READY boot=$(cat /proc/sys/kernel/random/boot_id)"
while :; do setsid sh -c 'exec sh </dev/ttyS0 >/dev/ttyS0 2>&1'; sleep 1; done
