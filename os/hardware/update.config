# Only the ota selector is exposed as MTD. Actual payload flashing is stock recovery's job.
CONFIG_MTD=m
# CONFIG_MTD_PARTITIONED_MASTER is not set
# CONFIG_MTD_BLOCK is not set
# CONFIG_MTD_CMDLINE_PARTS is not set
CONFIG_MTD_OF_PARTS=m
CONFIG_MTD_NAND_CORE=m
CONFIG_MTD_SPI_NAND=m
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_INGENIC_SFC=m
CONFIG_MMC_BLOCK=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_UTF8=m
