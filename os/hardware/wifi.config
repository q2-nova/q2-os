# Opt-in Wi-Fi transport and driver dependencies; no module loading at boot.
# External SDIO/gadget modules can register devices without this, but Linux
# otherwise compiles SO_BINDTODEVICE/SO_BINDTOIFINDEX into unsupported stubs.
CONFIG_NETDEVICES=y
# No additional hardware drivers are needed by this configuration repair.
# CONFIG_NET_CORE is not set
# CONFIG_ETHERNET is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_WLAN is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_FORCE_LOAD is not set
CONFIG_CFG80211=m
CONFIG_MMC=m
# CONFIG_MMC_BLOCK is not set
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PLTFM=m
CONFIG_MMC_SDHCI_INGENIC=m
CONFIG_REGULATOR_FIXED_VOLTAGE=m
# Keep the embedded module set inside the 6 MiB kernel slot.
CONFIG_KERNEL_XZ=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
