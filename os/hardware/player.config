# RAM application qualification; NAND remains inaccessible.
# CONFIG_MTD is not set
# CONFIG_DEVMEM is not set
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_RD_GZIP=y
CONFIG_BUILTIN_DTB=y
CONFIG_MIPS_CMDLINE_FROM_DTB=y
CONFIG_WATCHDOG_NOWAYOUT=n

# Bring up unqualified peripherals explicitly after USB diagnostics are ready.
CONFIG_I2C=m
CONFIG_I2C_CHARDEV=m
CONFIG_I2C_GPIO=m
CONFIG_I2C_JZ4780=m
CONFIG_MFD_AXP20X_I2C=m
CONFIG_REGULATOR_AXP20X=m
CONFIG_DRM=m
CONFIG_DRM_INGENIC_X2000=m
CONFIG_DRM_PANEL_SHANLING_Q2=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SHANLING_Q2=m
CONFIG_PWM_INGENIC_X2000=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_RTC_DRV_JZ4740=m

# USB card handoff is opt-in through q2-usb-storage, never automatic at boot.
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# Retain legacy beeper for the active DT; PCM binds only with patch 0051's DT.
CONFIG_INPUT_PWM_BEEPER=m
CONFIG_SND_DRIVERS=y
CONFIG_SND_X2000_PWM_AUDIO=m

# Defer MSC1 identification until modular PMIC combo rails are ready.
CONFIG_PWRSEQ_Q2=y
