#!/bin/sh
set -eu
mount -t configfs none /sys/kernel/config
g=/sys/kernel/config/usb_gadget/q2diag
mkdir "$g"
echo 0x1d6b > "$g/idVendor"
echo 0x0104 > "$g/idProduct"
mkdir -p "$g/strings/0x409" "$g/configs/c.1" "$g/functions/rndis.usb0"
echo Q2-diagnostic > "$g/strings/0x409/product"
echo q2-diagnostic-development > "$g/strings/0x409/serialnumber"
echo 02:51:32:00:00:02 > "$g/functions/rndis.usb0/dev_addr"
echo 02:51:32:00:00:01 > "$g/functions/rndis.usb0/host_addr"
ln -s "$g/functions/rndis.usb0" "$g/configs/c.1/"
set -- /sys/class/udc/*
[ "$#" -eq 1 ] && [ -e "$1" ]
basename "$1" > "$g/UDC"
# This direct management link has no router/DNS configuration.
if [ -w /proc/sys/net/ipv6/conf/usb0/disable_ipv6 ]; then
    echo 1 > /proc/sys/net/ipv6/conf/usb0/disable_ipv6
fi
ip link set usb0 up
ip addr add 192.168.77.2/30 dev usb0
