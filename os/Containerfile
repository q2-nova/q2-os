FROM docker.io/library/debian:trixie-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential bc bison flex patch perl python3 rsync file cpio unzip \
    wget curl ca-certificates git xz-utils bzip2 gzip tar locales \
    libncurses-dev libssl-dev libelf-dev device-tree-compiler u-boot-tools \
    squashfs-tools e2fsprogs dosfstools mtools \
    && rm -rf /var/lib/apt/lists/*
ENV LC_ALL=C TZ=UTC
