From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sat, 31 Oct 2026 13:54:16 -0500
Subject: [PATCH 20/20] watchdog: add X2000 RTC watchdog and preserve inherited
 arming

---
 .../watchdog/ingenic,x2000-watchdog.yaml      |  40 ++++
 arch/mips/boot/dts/ingenic/x2000.dtsi         |   7 +
 arch/mips/configs/shanling_q2_defconfig       |   4 +
 drivers/watchdog/Kconfig                      |  11 +
 drivers/watchdog/Makefile                     |   2 +
 drivers/watchdog/ingenic-x2000-wdt.c          | 190 ++++++++++++++++++
 6 files changed, 254 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/watchdog/ingenic,x2000-watchdog.yaml
 create mode 100644 drivers/watchdog/ingenic-x2000-wdt.c

diff --git a/Documentation/devicetree/bindings/watchdog/ingenic,x2000-watchdog.yaml b/Documentation/devicetree/bindings/watchdog/ingenic,x2000-watchdog.yaml
new file mode 100644
index 000000000..0479abc9d
--- /dev/null
+++ b/Documentation/devicetree/bindings/watchdog/ingenic,x2000-watchdog.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/watchdog/ingenic,x2000-watchdog.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 TCU watchdog
+
+maintainers:
+  - linux-mips@vger.kernel.org
+
+description: |
+  The X2000 TCU watchdog has a 16-bit full counter compare and a separate
+  half compare. This binding covers the watchdog register window only;
+  OST clock events and PWM are separate X2000 blocks.
+
+allOf:
+  - $ref: watchdog.yaml#
+
+properties:
+  compatible:
+    const: ingenic,x2000-watchdog
+  reg:
+    maxItems: 1
+  clocks:
+    items:
+      - description: TCU module gate
+      - description: Watchdog RTC source
+  clock-names:
+    items:
+      - const: tcu
+      - const: rtc
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
diff --git a/arch/mips/boot/dts/ingenic/x2000.dtsi b/arch/mips/boot/dts/ingenic/x2000.dtsi
index 6c5d69256..40e198767 100644
--- a/arch/mips/boot/dts/ingenic/x2000.dtsi
+++ b/arch/mips/boot/dts/ingenic/x2000.dtsi
@@ -61,6 +61,13 @@ cgu: clock-controller@10000000 {
 		clock-names = "ext", "rtc";
 	};
 
+	watchdog: watchdog@10002000 {
+		compatible = "ingenic,x2000-watchdog";
+		reg = <0x10002000 0x40>;
+		clocks = <&cgu X2000_CLK_TCU>, <&rtclk>;
+		clock-names = "tcu", "rtc";
+	};
+
 	ost: timer@12000000 {
 		compatible = "ingenic,x2000-ost";
 		/* global 64-bit counter, then the per-core timers */
diff --git a/arch/mips/configs/shanling_q2_defconfig b/arch/mips/configs/shanling_q2_defconfig
index c825d1041..88505c362 100644
--- a/arch/mips/configs/shanling_q2_defconfig
+++ b/arch/mips/configs/shanling_q2_defconfig
@@ -91,3 +91,7 @@ CONFIG_HIGH_RES_TIMERS=y
 CONFIG_PM=y
 # CONFIG_SUSPEND is not set
 CONFIG_RESET_CONTROLLER=y
+CONFIG_WATCHDOG=y
+CONFIG_WATCHDOG_SYSFS=y
+CONFIG_INGENIC_X2000_WDT=y
+# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
diff --git a/drivers/watchdog/Kconfig b/drivers/watchdog/Kconfig
index f7d0a0c2c..f0504c0d5 100644
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -1856,6 +1856,17 @@ config INDYDOG
 	  timer expired and no process has written to /dev/watchdog during
 	  that time.
 
+config INGENIC_X2000_WDT
+	tristate "Ingenic X2000 TCU watchdog"
+	depends on MACH_INGENIC_SOC || COMPILE_TEST
+	depends on OF && HAS_IOMEM && COMMON_CLK
+	select WATCHDOG_CORE
+	help
+	  Standard watchdog interface for the X2000 TCU RTC counter.
+	  Preserves an already armed RTC watchdog during driver probe.
+	  The Q2 integration uses a 32768 Hz RTC source and supports
+	  timeouts from 1 to 2047 seconds, without pretimeout interrupts.
+
 config JZ4740_WDT
 	tristate "Ingenic jz4740 SoC hardware watchdog"
 	depends on MIPS || COMPILE_TEST
diff --git a/drivers/watchdog/Makefile b/drivers/watchdog/Makefile
index 9ac406677..deb56f963 100644
--- a/drivers/watchdog/Makefile
+++ b/drivers/watchdog/Makefile
@@ -244,3 +244,5 @@ obj-$(CONFIG_MENZ069_WATCHDOG) += menz69_wdt.o
 obj-$(CONFIG_RAVE_SP_WATCHDOG) += rave-sp-wdt.o
 obj-$(CONFIG_STPMIC1_WATCHDOG) += stpmic1_wdt.o
 obj-$(CONFIG_SL28CPLD_WATCHDOG) += sl28cpld_wdt.o
+
+obj-$(CONFIG_INGENIC_X2000_WDT) += ingenic-x2000-wdt.o
diff --git a/drivers/watchdog/ingenic-x2000-wdt.c b/drivers/watchdog/ingenic-x2000-wdt.c
new file mode 100644
index 000000000..4f1558b89
--- /dev/null
+++ b/drivers/watchdog/ingenic-x2000-wdt.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* X2000 TCU watchdog: RTC counter and CLRZ protocol from Ingenic's SDK. */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/watchdog.h>
+
+#define WDT_TDR		0x00
+#define WDT_TCER	0x04
+#define WDT_TCNT	0x08
+#define WDT_TCSR	0x0c
+#define TCU_TSR		0x1c
+#define TCU_TFCR	0x28
+#define TCU_TMSR	0x34
+#define TCU_TSCR	0x3c
+#define WDT_STOP	BIT(16)
+#define WDT_FLAG	BIT(24)
+#define WDT_RTC		BIT(1)
+#define WDT_CLRZ	BIT(10)
+#define WDT_DIV1024	(5 << 3)
+
+struct x2000_wdt {
+	struct watchdog_device wdd;
+	void __iomem *base;
+	struct clk *tcu;
+	unsigned long rtc_rate;
+	unsigned long rate;
+};
+
+static bool nowayout = WATCHDOG_NOWAYOUT;
+module_param(nowayout, bool, 0444);
+MODULE_PARM_DESC(nowayout, "Watchdog cannot be stopped once started");
+
+static int x2000_wdt_ping(struct watchdog_device *wdd)
+{
+	struct x2000_wdt *wdt = watchdog_get_drvdata(wdd);
+	u32 control = readl(wdt->base + WDT_TCSR);
+
+	writel(control | WDT_CLRZ, wdt->base + WDT_TCSR);
+	return 0;
+}
+
+static int x2000_wdt_set_timeout(struct watchdog_device *wdd, unsigned int secs)
+{
+	struct x2000_wdt *wdt = watchdog_get_drvdata(wdd);
+	u32 enabled = readb(wdt->base + WDT_TCER) & 1;
+
+	writeb(0, wdt->base + WDT_TCER);
+	/* No pretimeout IRQ is advertised: mask and clear the SDK half flag. */
+	writel(WDT_FLAG, wdt->base + TCU_TMSR);
+	writel(WDT_FLAG, wdt->base + TCU_TFCR);
+	wdt->rate = wdt->rtc_rate / 1024;
+	writel(wdt->rate * secs, wdt->base + WDT_TDR);
+	writew(WDT_RTC | WDT_DIV1024 | WDT_CLRZ, wdt->base + WDT_TCSR);
+	writel(WDT_STOP, wdt->base + TCU_TSCR);
+	writeb(enabled, wdt->base + WDT_TCER);
+	wdd->timeout = secs;
+	return 0;
+}
+
+static int x2000_wdt_start(struct watchdog_device *wdd)
+{
+	struct x2000_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	x2000_wdt_set_timeout(wdd, wdd->timeout);
+	writeb(1, wdt->base + WDT_TCER);
+	return 0;
+}
+
+static int x2000_wdt_stop(struct watchdog_device *wdd)
+{
+	struct x2000_wdt *wdt = watchdog_get_drvdata(wdd);
+
+	writeb(0, wdt->base + WDT_TCER);
+	return 0;
+}
+
+static unsigned int x2000_wdt_get_timeleft(struct watchdog_device *wdd)
+{
+	struct x2000_wdt *wdt = watchdog_get_drvdata(wdd);
+	u32 full = readl(wdt->base + WDT_TDR) & 0xffff;
+	u32 count = readl(wdt->base + WDT_TCNT) & 0xffff;
+
+	return full > count ? DIV_ROUND_UP(full - count, wdt->rate) : 0;
+}
+
+static const struct watchdog_info x2000_wdt_info = {
+	.identity = "Ingenic X2000 watchdog",
+	.options = WDIOF_SETTIMEOUT | WDIOF_KEEPALIVEPING | WDIOF_MAGICCLOSE,
+};
+
+static const struct watchdog_ops x2000_wdt_ops = {
+	.owner = THIS_MODULE,
+	.start = x2000_wdt_start,
+	.stop = x2000_wdt_stop,
+	.ping = x2000_wdt_ping,
+	.set_timeout = x2000_wdt_set_timeout,
+	.get_timeleft = x2000_wdt_get_timeleft,
+};
+
+static void x2000_wdt_release_clock(void *data)
+{
+	struct x2000_wdt *wdt = data;
+
+	/* Probe failure/unbind must not disable an inherited reset deadline. */
+	if (!(readb(wdt->base + WDT_TCER) & 1))
+		clk_disable_unprepare(wdt->tcu);
+}
+
+static int x2000_wdt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct x2000_wdt *wdt;
+	struct clk *rtc;
+	u32 control, full, div;
+	int ret;
+
+	wdt = devm_kzalloc(dev, sizeof(*wdt), GFP_KERNEL);
+	if (!wdt)
+		return -ENOMEM;
+	wdt->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(wdt->base))
+		return PTR_ERR(wdt->base);
+	rtc = devm_clk_get(dev, "rtc");
+	if (IS_ERR(rtc))
+		return dev_err_probe(dev, PTR_ERR(rtc), "RTC clock unavailable\n");
+	wdt->rtc_rate = clk_get_rate(rtc);
+	/* This initial driver supports the Q2's 32768 Hz RTC source. */
+	if (wdt->rtc_rate != 32768)
+		return dev_err_probe(dev, -EINVAL, "requires 32768 Hz RTC\n");
+	wdt->tcu = devm_clk_get(dev, "tcu");
+	if (IS_ERR(wdt->tcu))
+		return dev_err_probe(dev, PTR_ERR(wdt->tcu), "TCU clock unavailable\n");
+	ret = clk_prepare_enable(wdt->tcu);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, x2000_wdt_release_clock, wdt);
+	if (ret)
+		return ret;
+
+	wdt->rate = wdt->rtc_rate / 1024;
+	wdt->wdd.info = &x2000_wdt_info;
+	wdt->wdd.ops = &x2000_wdt_ops;
+	wdt->wdd.parent = dev;
+	wdt->wdd.min_timeout = 1;
+	wdt->wdd.max_timeout = 0xffff / wdt->rate;
+	wdt->wdd.timeout = 15;
+	watchdog_set_drvdata(&wdt->wdd, wdt);
+	watchdog_set_nowayout(&wdt->wdd, nowayout);
+	ret = watchdog_init_timeout(&wdt->wdd, 0, dev);
+	if (ret)
+		return ret;
+
+	if ((readb(wdt->base + WDT_TCER) & 1) &&
+	    !(readl(wdt->base + TCU_TSR) & WDT_STOP)) {
+		control = readl(wdt->base + WDT_TCSR);
+		div = (control >> 3) & 7;
+		full = readl(wdt->base + WDT_TDR) & 0xffff;
+		if ((control & 7) != WDT_RTC || div > 5 || !full)
+			return dev_err_probe(dev, -EINVAL,
+					     "unsupported armed watchdog clock/compare\n");
+		wdt->rate = wdt->rtc_rate >> (2 * div);
+		wdt->wdd.timeout = DIV_ROUND_UP(full, wdt->rate);
+		set_bit(WDOG_HW_RUNNING, &wdt->wdd.status);
+		/* Preserve counter/compare: watchdog core owns subsequent policy. */
+	}
+
+	/* No stop-on-reboot: an armed watchdog must cover a kexec handoff. */
+	return devm_watchdog_register_device(dev, &wdt->wdd);
+}
+
+static const struct of_device_id x2000_wdt_of_match[] = {
+	{ .compatible = "ingenic,x2000-watchdog" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, x2000_wdt_of_match);
+
+static struct platform_driver x2000_wdt_driver = {
+	.probe = x2000_wdt_probe,
+	.driver = {
+		.name = "ingenic-x2000-watchdog",
+		.of_match_table = x2000_wdt_of_match,
+	},
+};
+module_platform_driver(x2000_wdt_driver);
+
+MODULE_DESCRIPTION("Ingenic X2000 TCU watchdog");
+MODULE_LICENSE("GPL");
