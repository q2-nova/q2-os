From 40758bd8c473f96e5bd688d8d33e74852f5aa111 Mon Sep 17 00:00:00 2001
From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sat, 31 Oct 2026 17:41:11 -0500
Subject: [PATCH] driver core: release old glue directory after device_move

get_device_parent takes a class-directory reference in addition to the
reference owned by the child kobject. A successful move drops only the
latter, leaking the former at every RNDIS detach/attach. After gadget
removal and allocation reuse, get_device_parent can find the stale net
directory and registration fails with ENOENT. Release the old directory
after a successful move. Existing error/rollback paths are unchanged.
Reproduced and validated by configfs gadget rebind followed by DWC2
platform removal/reprobe on Q2 emulation.
---
 drivers/base/core.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/base/core.c b/drivers/base/core.c
index 4c0c37399..850a154e7 100644
--- a/drivers/base/core.c
+++ b/drivers/base/core.c
@@ -4673,7 +4673,7 @@ int device_move(struct device *dev, struct device *new_parent,
 {
 	int error;
 	struct device *old_parent;
-	struct kobject *new_parent_kobj;
+	struct kobject *new_parent_kobj, *old_parent_kobj;
 
 	dev = get_device(dev);
 	if (!dev)
@@ -4690,6 +4690,7 @@ int device_move(struct device *dev, struct device *new_parent,
 
 	pr_debug("device: '%s': %s: moving to '%s'\n", dev_name(dev),
 		 __func__, new_parent ? dev_name(new_parent) : "<NULL>");
+	old_parent_kobj = get_glue_dir(dev);
 	error = kobject_move(&dev->kobj, new_parent_kobj);
 	if (error) {
 		cleanup_glue_dir(dev, new_parent_kobj);
@@ -4743,6 +4744,8 @@ int device_move(struct device *dev, struct device *new_parent,
 		break;
 	}
 
+	/* Drop the class-directory reference held for the old parent. */
+	cleanup_glue_dir(dev, old_parent_kobj);
 	put_device(old_parent);
 out:
 	device_pm_unlock();
