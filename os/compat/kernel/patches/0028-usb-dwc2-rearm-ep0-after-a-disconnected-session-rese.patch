From 3a6cbf09294118f8f483ea1936bb78b1b12ea995 Mon Sep 17 00:00:00 2001
From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sat, 31 Oct 2026 17:41:11 -0500
Subject: [PATCH] usb: dwc2: rearm ep0 after a disconnected session reset

Session-end disconnect clears connected and enters L3. A subsequent
valid-VBUS USB reset must initialize the core and restore L0 before
enumeration queues ep0; otherwise enqueue returns EAGAIN and cable
reconnect stalls. Reproduced with the Q2 peripheral and synthetic RNDIS
host.
---
 drivers/usb/dwc2/gadget.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index 102169b40..e1f9fb4ac 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -3759,7 +3759,11 @@ static irqreturn_t dwc2_hsotg_irq(int irq, void *pw)
 		/* Reset device address to zero */
 		dwc2_clear_bit(hsotg, DCFG, DCFG_DEVADDR_MASK);
 
-		if (usb_status & GOTGCTL_BSESVLD && connected)
+		/* Session-end already clears connected and leaves L3. A new
+		 * bus reset with valid VBUS must rearm EP0 from that state too.
+		 */
+		if (usb_status & GOTGCTL_BSESVLD &&
+		    (connected || hsotg->lx_state == DWC2_L3))
 			dwc2_hsotg_core_init_disconnected(hsotg, true);
 	}
 
