From 171deddf058dc63acebb8455c78d8f626f92592f Mon Sep 17 00:00:00 2001
From: Nova <361320585+q2-nova@users.noreply.github.com>
Date: Sat, 31 Oct 2026 17:41:11 -0500
Subject: [PATCH] phy: ingenic: add X2000 USB PHY and Q2 peripheral wiring

Adapt the CPM and analog-bank power sequence from the Ingenic vendor
driver in DiamondBond/q2-kernel 655f42c0 to the generic PHY API. Use
firmware-supplied board power as described by the pristine Q2 DT; no
guessed VBUS regulator or external detection GPIO. Enable DWC2 configfs
RNDIS for emulator validation. Analog settling and physical supply
behavior remain unqualified.
---
 .../bindings/phy/ingenic,x2000-usb-phy.yaml   |  49 +++++++
 arch/mips/boot/dts/ingenic/shanling-q2.dts    |   9 ++
 arch/mips/boot/dts/ingenic/x2000.dtsi         |  23 ++++
 arch/mips/configs/shanling_q2_defconfig       |   9 ++
 drivers/phy/ingenic/Kconfig                   |  11 ++
 drivers/phy/ingenic/Makefile                  |   1 +
 drivers/phy/ingenic/phy-ingenic-x2000.c       | 123 ++++++++++++++++++
 7 files changed, 225 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/ingenic,x2000-usb-phy.yaml
 create mode 100644 drivers/phy/ingenic/phy-ingenic-x2000.c

diff --git a/Documentation/devicetree/bindings/phy/ingenic,x2000-usb-phy.yaml b/Documentation/devicetree/bindings/phy/ingenic,x2000-usb-phy.yaml
new file mode 100644
index 000000000..71eae0c72
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/ingenic,x2000-usb-phy.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/ingenic,x2000-usb-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Ingenic X2000 CPM and analog USB PHY
+
+maintainers:
+  - Nova <361320585+q2-nova@users.noreply.github.com>
+
+description: |
+  Vendor-compatible X2000 PHY with CPM control and a separate analog register
+  bank. Unlike ingenic,x2000-phy, this describes both register windows and the
+  vendor reset sequence. Board supplies must already be enabled by firmware.
+  This binding does not describe host VBUS switching or external VBUS detection.
+
+properties:
+  compatible:
+    const: ingenic,usbphy-x2000
+
+  reg:
+    items:
+      - description: CPM control registers shared with the clock provider
+      - description: USB PHY analog registers
+
+  clocks:
+    maxItems: 1
+
+  '#phy-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - '#phy-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/ingenic,x2000-cgu.h>
+    usb-phy@10000000 {
+      compatible = "ingenic,usbphy-x2000";
+      reg = <0x10000000 0x100>, <0x10078000 0x110>;
+      clocks = <&cgu X2000_CLK_OTGPHY>;
+      #phy-cells = <0>;
+    };
diff --git a/arch/mips/boot/dts/ingenic/shanling-q2.dts b/arch/mips/boot/dts/ingenic/shanling-q2.dts
index d076fa333..e33925f02 100644
--- a/arch/mips/boot/dts/ingenic/shanling-q2.dts
+++ b/arch/mips/boot/dts/ingenic/shanling-q2.dts
@@ -385,3 +385,12 @@ dac3: audio-codec@33 {
 		VD-supply = <&dac_power>;
 	};
 };
+
+&usbphy {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";
+};
diff --git a/arch/mips/boot/dts/ingenic/x2000.dtsi b/arch/mips/boot/dts/ingenic/x2000.dtsi
index a2310200e..27436f862 100644
--- a/arch/mips/boot/dts/ingenic/x2000.dtsi
+++ b/arch/mips/boot/dts/ingenic/x2000.dtsi
@@ -61,6 +61,29 @@ cgu: clock-controller@10000000 {
 		clock-names = "ext", "rtc";
 	};
 
+	usbphy: usb-phy@10000000 {
+		compatible = "ingenic,usbphy-x2000";
+		reg = <0x10000000 0x100>, <0x10078000 0x110>;
+		clocks = <&cgu X2000_CLK_OTGPHY>;
+		#phy-cells = <0>;
+		status = "disabled";
+	};
+
+	otg: usb@13500000 {
+		compatible = "ingenic,x2000-otg";
+		reg = <0x13500000 0x40000>;
+		interrupt-parent = <&intc>;
+		interrupts = <1>;
+		clocks = <&cgu X2000_CLK_OTG>;
+		clock-names = "otg";
+		phys = <&usbphy>;
+		phy-names = "usb2-phy";
+		g-rx-fifo-size = <1096>;
+		g-np-tx-fifo-size = <512>;
+		g-tx-fifo-size = <16 16 16 128 256 256 512 768>;
+		status = "disabled";
+	};
+
 	watchdog: watchdog@10002000 {
 		compatible = "ingenic,x2000-watchdog";
 		reg = <0x10002000 0x40>;
diff --git a/arch/mips/configs/shanling_q2_defconfig b/arch/mips/configs/shanling_q2_defconfig
index b7747de86..93facf7ce 100644
--- a/arch/mips/configs/shanling_q2_defconfig
+++ b/arch/mips/configs/shanling_q2_defconfig
@@ -102,3 +102,12 @@ CONFIG_RTC_DRV_JZ4740=y
 
 CONFIG_KEXEC=y
 # CONFIG_CRASH_DUMP is not set
+
+CONFIG_USB=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_DWC2=y
+CONFIG_USB_DWC2_PERIPHERAL=y
+CONFIG_PHY_INGENIC_X2000_USB=y
+CONFIG_CONFIGFS_FS=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_RNDIS=y
diff --git a/drivers/phy/ingenic/Kconfig b/drivers/phy/ingenic/Kconfig
index f23cc1093..6d2e8aae9 100644
--- a/drivers/phy/ingenic/Kconfig
+++ b/drivers/phy/ingenic/Kconfig
@@ -11,3 +11,14 @@ config PHY_INGENIC_USB
 	help
 	  This driver provides USB PHY support for the USB controller found
 	  on the JZ-series and X-series SoCs from Ingenic.
+
+config PHY_INGENIC_X2000_USB
+	tristate "Ingenic X2000 CPM/analog USB PHY"
+	depends on MIPS || COMPILE_TEST
+	depends on USB_SUPPORT && HAS_IOMEM
+	select GENERIC_PHY
+	help
+	  Generic PHY API for the X2000 vendor CPM and analog register sequence.
+	  Requires board power supplies to be enabled by firmware.
+	  Controls both the CPM reset fields and the analog receiver bank.
+	  Used with the DWC2 peripheral controller on the Shanling Q2.
diff --git a/drivers/phy/ingenic/Makefile b/drivers/phy/ingenic/Makefile
index 1cb158d72..a80a479fc 100644
--- a/drivers/phy/ingenic/Makefile
+++ b/drivers/phy/ingenic/Makefile
@@ -1,2 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_PHY_INGENIC_USB)		+= phy-ingenic-usb.o
+obj-$(CONFIG_PHY_INGENIC_X2000_USB)	+= phy-ingenic-x2000.o
diff --git a/drivers/phy/ingenic/phy-ingenic-x2000.c b/drivers/phy/ingenic/phy-ingenic-x2000.c
new file mode 100644
index 000000000..f55156ad9
--- /dev/null
+++ b/drivers/phy/ingenic/phy-ingenic-x2000.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0
+/* X2000 PHY sequence from Ingenic's phy-ingenic-x2000.c, adapted to
+ * the generic PHY API. CPM and the additional analog register bank are
+ * both required. Board supply control is left to firmware, as in Q2 stock DT.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+
+#define USBPCR		0x3c
+#define USBPCR1		0x48
+#define SRBC		0xc4
+#define POR		BIT(22)
+#define PORT_RESET	BIT(21)
+#define CORE_RESET	BIT(12)
+
+struct x2000_usb_phy {
+	void __iomem *cpm;
+	void __iomem *analog;
+	struct clk *clk;
+};
+
+static void x2000_update(void __iomem *reg, u32 clear, u32 set)
+{
+	writel((readl(reg) & ~clear) | set, reg);
+}
+
+static int x2000_power_on(struct phy *phy)
+{
+	struct x2000_usb_phy *p = phy_get_drvdata(phy);
+	int ret;
+
+	x2000_update(p->cpm + SRBC, 0, CORE_RESET);
+	x2000_update(p->cpm + USBPCR, GENMASK(29, 28), BIT(31) | POR);
+	x2000_update(p->cpm + USBPCR1, 0, PORT_RESET);
+	usleep_range(10, 20);
+	x2000_update(p->cpm + USBPCR, POR, 0);
+	usleep_range(10, 20);
+	/* CGU enables OPCR.SPENDN0 and clears GATE_USBPHY_CLK. */
+	ret = clk_prepare_enable(p->clk);
+	if (ret) {
+		x2000_update(p->cpm + USBPCR, 0, POR);
+		return ret;
+	}
+	usleep_range(500, 1000);
+	x2000_update(p->cpm + USBPCR1, PORT_RESET, 0);
+	usleep_range(10, 20);
+	x2000_update(p->cpm + SRBC, CORE_RESET, 0);
+	/* Pull-down control and chirp/SE0 resume enable, vendor sequence. */
+	x2000_update(p->cpm + USBPCR1, 0, GENMASK(30, 28));
+	x2000_update(p->analog + 0x64, GENMASK(6, 3), 2 << 3);
+	/* Vendor resume: receiver and internal VBUS detector enabled. */
+	x2000_update(p->analog + 0x100, 0, BIT(6));
+	x2000_update(p->analog + 0x108, BIT(3), 0);
+	return 0;
+}
+
+static int x2000_power_off(struct phy *phy)
+{
+	struct x2000_usb_phy *p = phy_get_drvdata(phy);
+
+	x2000_update(p->analog + 0x108, 0, BIT(3));
+	x2000_update(p->analog + 0x100, BIT(6), 0);
+	/* Stop the controller before its clock and kernel DMA storage disappear. */
+	x2000_update(p->cpm + SRBC, 0, CORE_RESET);
+	x2000_update(p->cpm + USBPCR1, 0, PORT_RESET);
+	x2000_update(p->cpm + USBPCR, 0, POR);
+	clk_disable_unprepare(p->clk);
+	return 0;
+}
+
+static const struct phy_ops x2000_ops = {
+	.power_on = x2000_power_on,
+	.power_off = x2000_power_off,
+	.owner = THIS_MODULE,
+};
+
+static int x2000_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct x2000_usb_phy *p;
+	struct phy *phy;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->cpm = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->cpm))
+		return PTR_ERR(p->cpm);
+	p->analog = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(p->analog))
+		return PTR_ERR(p->analog);
+	p->clk = devm_clk_get(dev, NULL);
+	if (IS_ERR(p->clk))
+		return dev_err_probe(dev, PTR_ERR(p->clk), "PHY clock\n");
+	phy = devm_phy_create(dev, NULL, &x2000_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+	phy_set_drvdata(phy, p);
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id x2000_match[] = {
+	{ .compatible = "ingenic,usbphy-x2000" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, x2000_match);
+
+static struct platform_driver x2000_driver = {
+	.probe = x2000_probe,
+	.driver = {
+		.name = "ingenic-x2000-usb-phy",
+		.of_match_table = x2000_match,
+	},
+};
+module_platform_driver(x2000_driver);
+MODULE_DESCRIPTION("Ingenic X2000 CPM and analog USB PHY");
+MODULE_LICENSE("GPL");
