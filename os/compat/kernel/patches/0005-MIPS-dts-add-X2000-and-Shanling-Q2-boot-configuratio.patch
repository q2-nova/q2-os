diff --git a/arch/mips/boot/dts/ingenic/shanling-q2.dts b/arch/mips/boot/dts/ingenic/shanling-q2.dts
new file mode 100644
index 000000000..82088a509
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/shanling-q2.dts
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Shanling Q2 portable music player (Ingenic X2000, 128 MiB).
+ *
+ * Board wiring from the stock firmware's device tree and the parameters its
+ * board modules are loaded with.
+ */
+/dts-v1/;
+
+#include "x2000.dtsi"
+
+/ {
+	model = "Shanling Q2";
+	compatible = "shanling,q2", "ingenic,x2000";
+
+	aliases {
+		serial0 = &uart0;
+		serial3 = &uart3;
+	};
+
+	chosen {
+		stdout-path = "serial3:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x8000000>;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
diff --git a/arch/mips/boot/dts/ingenic/x2000.dtsi b/arch/mips/boot/dts/ingenic/x2000.dtsi
new file mode 100644
index 000000000..6ad411109
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/x2000.dtsi
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Ingenic X2000 SoC.
+ *
+ * Based on the X2000 device tree by Zhou Yanjie in the Ingenic-community
+ * kernel, with the interrupt controller, OST and CCU as the vendor kernel
+ * uses them.
+ */
+#include <dt-bindings/clock/ingenic,x2000-cgu.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "ingenic,x2000";
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2";
+			reg = <0>;
+			clocks = <&cgu X2000_CLK_CPU>;
+			clock-names = "cpu";
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "ingenic,xburst2";
+			reg = <1>;
+			clocks = <&cgu X2000_CLK_CPU>;
+			clock-names = "cpu";
+		};
+	};
+
+	cpuintc: interrupt-controller {
+		compatible = "mti,cpu-interrupt-controller";
+		#address-cells = <0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+	};
+
+	exclk: ext {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	rtclk: rtc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	cgu: clock-controller@10000000 {
+		compatible = "ingenic,x2000-cgu";
+		reg = <0x10000000 0x100>;
+		#clock-cells = <1>;
+		clocks = <&exclk>, <&rtclk>;
+		clock-names = "ext", "rtc";
+	};
+
+	ost: timer@12000000 {
+		compatible = "ingenic,x2000-ost";
+		/* global 64-bit counter, then the per-core timers */
+		reg = <0x12000000 0x20>, <0x12100000 0x200>;
+		clocks = <&cgu X2000_CLK_OST>;
+		clock-names = "ost";
+		interrupt-parent = <&cpuintc>;
+		interrupts = <4>;
+	};
+
+	ccu: core-control@12200000 {
+		compatible = "ingenic,x2000-ccu";
+		reg = <0x12200000 0x2000>;
+	};
+
+	intc: interrupt-controller@12300000 {
+		compatible = "ingenic,x2000-intc";
+		/* one bank per core, 0x100 apart */
+		reg = <0x12300000 0x200>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&cpuintc>;
+		interrupts = <2>;
+	};
+
+	pinctrl: pin-controller@10010000 {
+		compatible = "ingenic,x2000-pinctrl";
+		reg = <0x10010000 0x800>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gpa: gpio@0 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <0>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 0 32>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intc>;
+			interrupts = <17>;
+		};
+
+		gpb: gpio@1 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <1>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 32 32>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intc>;
+			interrupts = <16>;
+		};
+
+		gpc: gpio@2 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <2>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 64 32>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intc>;
+			interrupts = <15>;
+		};
+
+		gpd: gpio@3 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <3>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 96 32>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intc>;
+			interrupts = <14>;
+		};
+
+		gpe: gpio@4 {
+			compatible = "ingenic,x2000-gpio";
+			reg = <4>;
+			gpio-controller;
+			gpio-ranges = <&pinctrl 0 128 32>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&intc>;
+			interrupts = <13>;
+		};
+	};
+
+	uart0: serial@10030000 {
+		compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
+		reg = <0x10030000 0x100>;
+		interrupt-parent = <&intc>;
+		interrupts = <47>;
+		clocks = <&exclk>, <&cgu X2000_CLK_UART0>;
+		clock-names = "baud", "module";
+		status = "disabled";
+	};
+
+	uart1: serial@10031000 {
+		compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
+		reg = <0x10031000 0x100>;
+		interrupt-parent = <&intc>;
+		interrupts = <46>;
+		clocks = <&exclk>, <&cgu X2000_CLK_UART1>;
+		clock-names = "baud", "module";
+		status = "disabled";
+	};
+
+	uart2: serial@10032000 {
+		compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
+		reg = <0x10032000 0x100>;
+		interrupt-parent = <&intc>;
+		interrupts = <45>;
+		clocks = <&exclk>, <&cgu X2000_CLK_UART2>;
+		clock-names = "baud", "module";
+		status = "disabled";
+	};
+
+	uart3: serial@10033000 {
+		compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
+		reg = <0x10033000 0x100>;
+		interrupt-parent = <&intc>;
+		interrupts = <44>;
+		clocks = <&exclk>, <&cgu X2000_CLK_UART3>;
+		clock-names = "baud", "module";
+		status = "disabled";
+	};
+};
