diff --git a/sound/soc/jz4740/shanling-q2.c b/sound/soc/jz4740/shanling-q2.c
new file mode 100644
index 000000000..0c5b1a536
--- /dev/null
+++ b/sound/soc/jz4740/shanling-q2.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Q2 PCM topology from stock codec_cs43131.ko. Emulator-qualified only. */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include "../codecs/cs43130.h"
+
+struct q2_audio {
+	struct snd_soc_card card;
+	struct snd_soc_dai_link link;
+	struct snd_soc_dai_link_component cpu, platform, codecs[4];
+	struct snd_soc_codec_conf conf[4];
+	struct gpio_desc *mute, *mode, *boost;
+};
+
+static int q2_output_event(struct snd_soc_dapm_widget *widget,
+			   struct snd_kcontrol *control, int event)
+{
+	struct q2_audio *q2 = snd_soc_card_get_drvdata(snd_soc_dapm_to_card(widget->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		gpiod_set_value_cansleep(q2->mute, 1);
+		msleep(200);
+		gpiod_set_value_cansleep(q2->mode, 1);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		msleep(50);
+		gpiod_set_value_cansleep(q2->mute, 0);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		gpiod_set_value_cansleep(q2->mute, 1);
+		msleep(300);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		gpiod_set_value_cansleep(q2->mode, 0);
+		break;
+	}
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget q2_widgets[] = {
+	SND_SOC_DAPM_OUT_DRV_E("Output", SND_SOC_NOPM, 0, 0, NULL, 0,
+		q2_output_event, SND_SOC_DAPM_PRE_PMU | SND_SOC_DAPM_POST_PMU |
+		SND_SOC_DAPM_PRE_PMD | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_HP("Headphones", NULL),
+};
+
+static const struct snd_soc_dapm_route q2_routes[] = {
+	{ "Output", NULL, "DAC0 HPOUTA" },
+	{ "Output", NULL, "DAC0 HPOUTB" },
+	{ "Output", NULL, "DAC1 HPOUTA" },
+	{ "Output", NULL, "DAC1 HPOUTB" },
+	{ "Output", NULL, "DAC2 HPOUTA" },
+	{ "Output", NULL, "DAC2 HPOUTB" },
+	{ "Output", NULL, "DAC3 HPOUTA" },
+	{ "Output", NULL, "DAC3 HPOUTB" },
+	{ "Headphones", NULL, "Output" },
+};
+
+static int q2_link_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dai *codec;
+	int i, ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec) {
+		snd_soc_dapm_set_idle_bias(snd_soc_component_to_dapm(codec->component), false);
+		/* Stock initialization uses the 22.5792 MHz crystal family.
+		 * The codec driver can synthesize 24.576 MHz using its PLL.
+		 */
+		ret = snd_soc_component_set_sysclk(codec->component, 0,
+			CS43130_MCLK_SRC_EXT, CS43130_MCLK_22M, SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int q2_hw_params(struct snd_pcm_substream *substream,
+			struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *codec;
+	unsigned int slots[2];
+	int i, ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec) {
+		ret = snd_soc_dai_set_sysclk(codec, 0, params_rate(params) * 64,
+					    SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+		/* Stock addresses 0x30/31 copy left; 0x32/33 copy right.
+		 * Invert B in each pair (stock PCM_PATH_CTL_2 values 5/7).
+		 */
+		slots[0] = slots[1] = i >= 2;
+		ret = snd_soc_dai_set_channel_map(codec, 0, NULL, 2, slots);
+		if (ret)
+			return ret;
+		ret = snd_soc_component_update_bits(codec->component,
+			CS43130_PCM_PATH_CTL_2, BIT(2) | BIT(3), BIT(2));
+		if (ret < 0)
+			return ret;
+	}
+	return 0;
+}
+
+static const struct snd_soc_ops q2_ops = {
+	.hw_params = q2_hw_params,
+};
+
+static void q2_put_nodes(void *data)
+{
+	struct q2_audio *q2 = data;
+	int i;
+
+	of_node_put(q2->cpu.of_node);
+	for (i = 0; i < ARRAY_SIZE(q2->codecs); i++)
+		of_node_put(q2->codecs[i].of_node);
+}
+
+static void q2_mute(void *data)
+{
+	struct q2_audio *q2 = data;
+
+	gpiod_set_value_cansleep(q2->mute, 1);
+	gpiod_set_value_cansleep(q2->mode, 0);
+	gpiod_set_value_cansleep(q2->boost, 0);
+}
+
+static int q2_audio_probe(struct platform_device *pdev)
+{
+	static const char * const prefixes[] = { "DAC0", "DAC1", "DAC2", "DAC3" };
+	struct device *dev = &pdev->dev;
+	struct q2_audio *q2;
+	int i, ret;
+
+	q2 = devm_kzalloc(dev, sizeof(*q2), GFP_KERNEL);
+	if (!q2)
+		return -ENOMEM;
+	q2->mute = devm_gpiod_get(dev, "mute", GPIOD_OUT_HIGH);
+	if (IS_ERR(q2->mute))
+		return dev_err_probe(dev, PTR_ERR(q2->mute), "Cannot get mute GPIO\n");
+	q2->mode = devm_gpiod_get(dev, "mode", GPIOD_OUT_LOW);
+	if (IS_ERR(q2->mode))
+		return dev_err_probe(dev, PTR_ERR(q2->mode), "Cannot get mode GPIO\n");
+	/* PB2 is switched by stock high-volume policy, not the codec VCP
+	 * supply. Keep it low until that policy has been qualified.
+	 */
+	q2->boost = devm_gpiod_get(dev, "boost", GPIOD_OUT_LOW);
+	if (IS_ERR(q2->boost))
+		return dev_err_probe(dev, PTR_ERR(q2->boost), "Cannot get boost GPIO\n");
+	ret = devm_add_action_or_reset(dev, q2_mute, q2);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, q2_put_nodes, q2);
+	if (ret)
+		return ret;
+	q2->cpu.of_node = of_parse_phandle(dev->of_node, "audio-controller", 0);
+	if (!q2->cpu.of_node ||
+	    of_count_phandle_with_args(dev->of_node, "audio-codecs", NULL) != 4)
+		return -EINVAL;
+	q2->platform.of_node = q2->cpu.of_node;
+	q2->cpu.dai_name = "x2000-baic1";
+	for (i = 0; i < ARRAY_SIZE(q2->codecs); i++) {
+		q2->codecs[i].of_node = of_parse_phandle(dev->of_node, "audio-codecs", i);
+		if (!q2->codecs[i].of_node)
+			return -EINVAL;
+		q2->codecs[i].dai_name = "cs43130-asp-pcm";
+		q2->conf[i].dlc.of_node = q2->codecs[i].of_node;
+		q2->conf[i].name_prefix = prefixes[i];
+	}
+	q2->link.name = "Q2 PCM";
+	q2->link.stream_name = "Q2 PCM";
+	q2->link.cpus = &q2->cpu;
+	q2->link.num_cpus = 1;
+	q2->link.platforms = &q2->platform;
+	q2->link.num_platforms = 1;
+	q2->link.codecs = q2->codecs;
+	q2->link.num_codecs = ARRAY_SIZE(q2->codecs);
+	q2->link.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			   SND_SOC_DAIFMT_CBC_CFC;
+	q2->link.init = q2_link_init;
+	q2->link.ops = &q2_ops;
+	q2->link.playback_only = 1;
+	q2->card.name = "Shanling Q2";
+	q2->card.owner = THIS_MODULE;
+	q2->card.dev = dev;
+	q2->card.dai_link = &q2->link;
+	q2->card.num_links = 1;
+	q2->card.codec_conf = q2->conf;
+	q2->card.num_configs = ARRAY_SIZE(q2->conf);
+	q2->card.dapm_widgets = q2_widgets;
+	q2->card.num_dapm_widgets = ARRAY_SIZE(q2_widgets);
+	q2->card.dapm_routes = q2_routes;
+	q2->card.num_dapm_routes = ARRAY_SIZE(q2_routes);
+	snd_soc_card_set_drvdata(&q2->card, q2);
+	platform_set_drvdata(pdev, q2);
+	return devm_snd_soc_register_card(dev, &q2->card);
+}
+
+static const struct of_device_id q2_audio_of_match[] = {
+	{ .compatible = "shanling,q2-audio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, q2_audio_of_match);
+
+static struct platform_driver q2_audio_driver = {
+	.probe = q2_audio_probe,
+	.driver = {
+		.name = "shanling-q2-audio",
+		.of_match_table = q2_audio_of_match,
+	},
+};
+module_platform_driver(q2_audio_driver);
+
+MODULE_DESCRIPTION("Shanling Q2 PCM sound card");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/jz4740/x2000-audio.c b/sound/soc/jz4740/x2000-audio.c
new file mode 100644
index 000000000..63ef38d94
--- /dev/null
+++ b/sound/soc/jz4740/x2000-audio.c
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * X2000 audio DMA0 -> DSP source 8 / timeslot 9 -> BAIC1.
+ * Register/protocol evidence: Q2 soc_audio_dma.ko and soc_aic.ko, with
+ * Ingenic as-v2 headers for register names. This intentionally follows the
+ * stock single cyclic descriptor and pointer-polling protocol: its LINK
+ * encoding differs from the SDK, so no unverified IRQ protocol is assumed.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/hrtimer.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#define DBA		0x0000
+#define DCR		0x0008
+#define DSR		0x000c
+#define DCM		0x0010
+#define DDA		0x0014
+#define DGRR		0x0100
+#define FAS		0x1000
+#define FCR		0x1004
+#define FFR		0x1008
+#define DFCR		0x2000
+#define BTSET		0x4000
+#define BTCLR		0x4004
+#define BFCR0		0x4010
+#define BFCR1		0x4014
+#define BFCR2		0x4018
+#define BST1		0x4020
+#define BTT0		0x4028
+#define TCTL		0x6010
+#define TCFG		0x6014
+#define TDIV		0x6018
+#define TCGR		0x601c
+#define TLCR		0x6020
+#define CCR		0x6024
+#define POLL_NS		1000000
+#define BUFFER_MAX	(256 * 1024)
+
+struct x2000_audio {
+	void __iomem *base;
+	struct clk_bulk_data clocks[2];
+	__le32 *desc;
+	dma_addr_t desc_dma;
+	struct hrtimer timer;
+	struct snd_pcm_substream *substream;
+	bool running;
+	unsigned int buffer_bytes, period_bytes, last_pos, period_pos;
+};
+
+static unsigned int x2000_position(struct x2000_audio *audio)
+{
+	u32 pos = readl(audio->base + DBA) -
+		  audio->substream->runtime->dma_addr;
+
+	return pos < audio->buffer_bytes ? pos : 0;
+}
+
+static enum hrtimer_restart x2000_poll(struct hrtimer *timer)
+{
+	struct x2000_audio *audio = container_of(timer, struct x2000_audio, timer);
+	struct snd_pcm_substream *substream = audio->substream;
+	unsigned long flags;
+	unsigned int pos, delta;
+	bool running;
+
+	/* trigger and this callback serialize through ALSA's stream lock.
+	 * sync_stop/close cancel outside that lock before buffers are freed.
+	 */
+	if (WARN_ON_ONCE(!substream))
+		return HRTIMER_NORESTART;
+	snd_pcm_stream_lock_irqsave(substream, flags);
+	if (audio->running) {
+		pos = x2000_position(audio);
+		delta = (pos + audio->buffer_bytes - audio->last_pos) %
+			audio->buffer_bytes;
+		audio->last_pos = pos;
+		audio->period_pos += delta;
+		if (audio->period_pos >= audio->period_bytes) {
+			audio->period_pos %= audio->period_bytes;
+			snd_pcm_period_elapsed_under_stream_lock(substream);
+		}
+	}
+	running = audio->running;
+	snd_pcm_stream_unlock_irqrestore(substream, flags);
+	if (!running)
+		return HRTIMER_NORESTART;
+	hrtimer_forward_now(timer, ns_to_ktime(POLL_NS));
+	return HRTIMER_RESTART;
+}
+
+static const struct snd_pcm_hardware x2000_pcm_hw = {
+	.info = SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
+		SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_PAUSE,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+		   SNDRV_PCM_FMTBIT_S32_LE,
+	.rates = SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_96000,
+	.rate_min = 44100,
+	.rate_max = 96000,
+	.channels_min = 2,
+	.channels_max = 2,
+	.buffer_bytes_max = BUFFER_MAX,
+	.period_bytes_min = 1024,
+	.period_bytes_max = 32768,
+	.periods_min = 4,
+	.periods_max = 32,
+};
+
+static int x2000_open(struct snd_soc_component *component,
+		     struct snd_pcm_substream *substream)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	runtime->hw = x2000_pcm_hw;
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		return ret;
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					SNDRV_PCM_HW_PARAM_PERIOD_BYTES, 32);
+	if (ret < 0)
+		return ret;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(audio->clocks), audio->clocks);
+	if (ret < 0)
+		return ret;
+	writel(1, audio->base + DGRR);
+	audio->substream = substream;
+	return 0;
+}
+
+static void x2000_stop(struct x2000_audio *audio)
+{
+	audio->running = false;
+	writel(0, audio->base + DCM);
+	writel(0, audio->base + FCR);
+	writel(0, audio->base + DCR);
+	writel(0, audio->base + CCR);
+}
+
+static int x2000_close(struct snd_soc_component *component,
+		      struct snd_pcm_substream *substream)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+
+	hrtimer_cancel(&audio->timer);
+	x2000_stop(audio);
+	writel(2, audio->base + DCR);
+	writel(0, audio->base + DFCR);
+	writel(BIT(9), audio->base + BTCLR);
+	writel(0, audio->base + BST1);
+	writel(0, audio->base + BTT0);
+	audio->substream = NULL;
+	clk_bulk_disable_unprepare(ARRAY_SIZE(audio->clocks), audio->clocks);
+	return 0;
+}
+
+static int x2000_hw_params(struct snd_soc_component *component,
+			  struct snd_pcm_substream *substream,
+			  struct snd_pcm_hw_params *params)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+	unsigned int rate = params_rate(params);
+	unsigned long mclk = rate == 44100 ? 22579200 : 24576000;
+	unsigned int width = params_width(params), code;
+	int ret;
+
+	if (params_channels(params) != 2)
+		return -EINVAL;
+	switch (width) {
+	case 16:
+		code = 3;
+		break;
+	case 24:
+		code = 6;
+		break;
+	case 32:
+		code = 7;
+		break;
+	default:
+		return -EINVAL;
+	}
+	ret = clk_set_rate(audio->clocks[1].clk, mclk);
+	if (ret)
+		return ret;
+	if (clk_get_rate(audio->clocks[1].clk) != mclk)
+		return -EINVAL;
+
+	audio->buffer_bytes = params_buffer_bytes(params);
+	audio->period_bytes = params_period_bytes(params);
+	writel(0, audio->base + CCR);
+	writel(1, audio->base + TCTL);
+	writel(0, audio->base + TCGR);
+	writel(1, audio->base + TLCR);
+	/* Stereo I2S, 64 bit clocks per frame, CPU is clock provider. */
+	writel(BIT(17) | (code << 8) | (4 << 2) | 1, audio->base + TCFG);
+	writel(((mclk / (rate * 64)) << 16) | 3, audio->base + TDIV);
+	writel((1 << 12) | (code << 8), audio->base + DFCR);
+	return 0;
+}
+
+static int x2000_prepare(struct snd_soc_component *component,
+			struct snd_pcm_substream *substream)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+
+	hrtimer_cancel(&audio->timer);
+	x2000_stop(audio);
+	writel(2, audio->base + DCR);
+	udelay(100);
+	writel(0x3c, audio->base + DSR);
+	/* Stock descriptor: incrementing buffer, 32-byte burst, self link. */
+	audio->desc[0] = cpu_to_le32(0x120);
+	audio->desc[1] = cpu_to_le32(substream->runtime->dma_addr);
+	audio->desc[2] = cpu_to_le32(audio->desc_dma);
+	audio->desc[3] = cpu_to_le32(audio->buffer_bytes / 32);
+	dma_wmb();
+	writel(audio->desc_dma, audio->base + DDA);
+	writel(384, audio->base + FAS);
+	writel(8 << 16, audio->base + FFR);
+	writel(0xfff, audio->base + BFCR1);
+	writel(0x7fff, audio->base + BFCR2);
+	writel(BIT(8) | BIT(17), audio->base + BFCR0);
+	writel(9 << 10, audio->base + BST1);
+	writel(9 << 5, audio->base + BTT0);
+	writel(BIT(9), audio->base + BTSET);
+	audio->last_pos = 0;
+	audio->period_pos = 0;
+	return 0;
+}
+
+static int x2000_trigger(struct snd_soc_component *component,
+			struct snd_pcm_substream *substream, int cmd)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		writel(readl(audio->base + DFCR) | 1, audio->base + DFCR);
+		writel(1, audio->base + DCR);
+		writel(1, audio->base + FCR);
+		writel(8, audio->base + CCR);
+		audio->running = true;
+		hrtimer_start(&audio->timer, ns_to_ktime(POLL_NS), HRTIMER_MODE_REL);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		x2000_stop(audio);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int x2000_sync_stop(struct snd_soc_component *component,
+			  struct snd_pcm_substream *substream)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+
+	u32 status;
+	int ret;
+
+	hrtimer_cancel(&audio->timer);
+	ret = readl_poll_timeout(audio->base + DSR, status, !(status & 2), 10, 10000);
+	if (ret) {
+		dev_err(component->dev, "DMA stop timed out; resetting channel\n");
+		writel(2, audio->base + DCR);
+		udelay(100);
+	}
+	return ret;
+}
+
+static snd_pcm_uframes_t x2000_pointer(struct snd_soc_component *component,
+				     struct snd_pcm_substream *substream)
+{
+	struct x2000_audio *audio = snd_soc_component_get_drvdata(component);
+
+	return bytes_to_frames(substream->runtime, x2000_position(audio));
+}
+
+static int x2000_pcm_new(struct snd_soc_component *component,
+			struct snd_soc_pcm_runtime *rtd)
+{
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_DEV,
+				       component->dev, BUFFER_MAX, BUFFER_MAX);
+	return 0;
+}
+
+static const struct snd_soc_component_driver x2000_component = {
+	.name = "x2000-audio",
+	.open = x2000_open,
+	.close = x2000_close,
+	.hw_params = x2000_hw_params,
+	.prepare = x2000_prepare,
+	.trigger = x2000_trigger,
+	.sync_stop = x2000_sync_stop,
+	.pointer = x2000_pointer,
+	.pcm_new = x2000_pcm_new,
+};
+
+static int x2000_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S ||
+	    (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_BP_FP ||
+	    (fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops x2000_dai_ops = {
+	.set_fmt = x2000_set_fmt,
+};
+
+static struct snd_soc_dai_driver x2000_dai = {
+	.name = "x2000-baic1",
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 2,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_44100 | SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_96000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+			   SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &x2000_dai_ops,
+};
+
+static int x2000_audio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct x2000_audio *audio;
+	int ret;
+
+	audio = devm_kzalloc(dev, sizeof(*audio), GFP_KERNEL);
+	if (!audio)
+		return -ENOMEM;
+	audio->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(audio->base))
+		return PTR_ERR(audio->base);
+	audio->clocks[0].id = "audio";
+	audio->clocks[1].id = "i2s1";
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(audio->clocks), audio->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "Cannot get clocks\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(29));
+	if (ret)
+		return ret;
+	audio->desc = dmam_alloc_coherent(dev, 16, &audio->desc_dma, GFP_KERNEL);
+	if (!audio->desc)
+		return -ENOMEM;
+	hrtimer_setup(&audio->timer, x2000_poll, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	platform_set_drvdata(pdev, audio);
+	return devm_snd_soc_register_component(dev, &x2000_component, &x2000_dai, 1);
+}
+
+static const struct of_device_id x2000_audio_of_match[] = {
+	{ .compatible = "ingenic,x2000-audio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, x2000_audio_of_match);
+
+static struct platform_driver x2000_audio_driver = {
+	.probe = x2000_audio_probe,
+	.driver = {
+		.name = "x2000-audio",
+		.of_match_table = x2000_audio_of_match,
+	},
+};
+module_platform_driver(x2000_audio_driver);
+
+MODULE_DESCRIPTION("Ingenic X2000 BAIC1 playback");
+MODULE_LICENSE("GPL");
