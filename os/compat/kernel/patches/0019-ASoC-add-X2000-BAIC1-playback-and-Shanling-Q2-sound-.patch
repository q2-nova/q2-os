+++ b/Documentation/devicetree/bindings/sound/ingenic,x2000-audio.yaml
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/ingenic,x2000-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Ingenic X2000 audio subsystem
+maintainers:
+  - linux-mips@vger.kernel.org
+description: |
+  Audio DMA, FIFOs, format conversion, DSP timeslot routing and BAIC ports.
+  The initial driver supports stereo PCM through DMA0 and BAIC1 using the
+  Q2 stock descriptor and pointer-polling protocol.
+properties:
+  compatible:
+    const: ingenic,x2000-audio
+  reg:
+    maxItems: 1
+  clocks:
+    items:
+      - description: Audio subsystem bus gate
+      - description: BAIC1 serial clock with its gate
+  clock-names:
+    items:
+      - const: audio
+      - const: i2s1
+  '#sound-dai-cells':
+    const: 0
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#sound-dai-cells'
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/sound/shanling,q2-audio.yaml b/Documentation/devicetree/bindings/sound/shanling,q2-audio.yaml
new file mode 100644
index 000000000..5dc50fc58
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/shanling,q2-audio.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/shanling,q2-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Shanling Q2 audio topology
+maintainers:
+  - linux-mips@vger.kernel.org
+description: |
+  X2000 BAIC1 drives four CS43131 control endpoints. In the stock PCM
+  configuration 0x30/31 copy left, 0x32/33 copy right, and B is inverted on
+  each endpoint. These are software-derived routing facts; analog wiring
+  and downstream supply topology still require board qualification.
+properties:
+  compatible:
+    const: shanling,q2-audio
+  audio-controller:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: X2000 audio subsystem
+  audio-codecs:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - description: CS43131 at address 0x30
+        maxItems: 1
+      - description: CS43131 at address 0x31
+        maxItems: 1
+      - description: CS43131 at address 0x32
+        maxItems: 1
+      - description: CS43131 at address 0x33
+        maxItems: 1
+    description: Four codec endpoints, in ascending I2C address order
+  mute-gpios:
+    maxItems: 1
+    description: Board output mute, active high on PB10
+  mode-gpios:
+    maxItems: 1
+    description: Board output mode, high for the stock headphone path on PB9
+  boost-gpios:
+    maxItems: 1
+    description: Stock high-volume boost control on PB2; initially held low
+required:
+  - compatible
+  - audio-controller
+  - audio-codecs
+  - mute-gpios
+  - mode-gpios
+  - boost-gpios
+additionalProperties: false
diff --git a/arch/mips/boot/dts/ingenic/shanling-q2.dts b/arch/mips/boot/dts/ingenic/shanling-q2.dts
index bd19748a0..fb7472076 100644
--- a/arch/mips/boot/dts/ingenic/shanling-q2.dts
+++ b/arch/mips/boot/dts/ingenic/shanling-q2.dts
@@ -287,3 +287,93 @@ ports {
 		port@1 { reg = <1>; dsi_out: endpoint { remote-endpoint = <&panel_in>; }; };
 	};
 };
+
+/ {
+	/* PB1 is the stock DAC enable. Individual downstream rail topology
+	 * and voltages remain unqualified; do not invent voltage constraints.
+	 */
+	dac_power: regulator-dac {
+		compatible = "regulator-fixed";
+		regulator-name = "dac-power";
+		gpio = <&gpb 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <50000>;
+	};
+
+	sound {
+		compatible = "shanling,q2-audio";
+		audio-controller = <&audio>;
+		audio-codecs = <&dac0>, <&dac1>, <&dac2>, <&dac3>;
+		mute-gpios = <&gpb 10 GPIO_ACTIVE_HIGH>;
+		mode-gpios = <&gpb 9 GPIO_ACTIVE_HIGH>;
+		boost-gpios = <&gpb 2 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&pinctrl {
+	i2s1_pins: i2s1-pins {
+		function = "i2s1";
+		groups = "i2s1-data-tx", "i2s1-clk-tx";
+	};
+};
+
+&audio {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1_pins>;
+};
+
+&i2c5 {
+	dac0: audio-codec@30 {
+		compatible = "cirrus,cs43131";
+		reg = <0x30>;
+		/* Board reset is inverted relative to the IC's RESET pin. */
+		reset-gpios = <&gpb 14 GPIO_ACTIVE_HIGH>;
+		cirrus,shared-reset;
+		cirrus,xtal-ibias = <2>;
+		VA-supply = <&dac_power>;
+		VP-supply = <&dac_power>;
+		VL-supply = <&dac_power>;
+		VCP-supply = <&dac_power>;
+		VD-supply = <&dac_power>;
+	};
+	dac1: audio-codec@31 {
+		compatible = "cirrus,cs43131";
+		reg = <0x31>;
+		/* Board reset is inverted relative to the IC's RESET pin. */
+		reset-gpios = <&gpb 14 GPIO_ACTIVE_HIGH>;
+		cirrus,shared-reset;
+		cirrus,xtal-ibias = <2>;
+		VA-supply = <&dac_power>;
+		VP-supply = <&dac_power>;
+		VL-supply = <&dac_power>;
+		VCP-supply = <&dac_power>;
+		VD-supply = <&dac_power>;
+	};
+	dac2: audio-codec@32 {
+		compatible = "cirrus,cs43131";
+		reg = <0x32>;
+		/* Board reset is inverted relative to the IC's RESET pin. */
+		reset-gpios = <&gpb 14 GPIO_ACTIVE_HIGH>;
+		cirrus,shared-reset;
+		cirrus,xtal-ibias = <2>;
+		VA-supply = <&dac_power>;
+		VP-supply = <&dac_power>;
+		VL-supply = <&dac_power>;
+		VCP-supply = <&dac_power>;
+		VD-supply = <&dac_power>;
+	};
+	dac3: audio-codec@33 {
+		compatible = "cirrus,cs43131";
+		reg = <0x33>;
+		/* Board reset is inverted relative to the IC's RESET pin. */
+		reset-gpios = <&gpb 14 GPIO_ACTIVE_HIGH>;
+		cirrus,shared-reset;
+		cirrus,xtal-ibias = <2>;
+		VA-supply = <&dac_power>;
+		VP-supply = <&dac_power>;
+		VL-supply = <&dac_power>;
+		VCP-supply = <&dac_power>;
+		VD-supply = <&dac_power>;
+	};
+};
