#!/bin/sh
# Normal installed image only. Retain the card's public keys in RAM this boot.
set -eu
umask 077
runtime=/run/q2/card-ssh
private=/state/card-ssh
key=/mnt/mmc/authorized_keys
identity=$private/hostkey

stage() {
    # The launcher has had its one initial chance to mount the physical card.
    # Stay independent of a card writable enough for the player's media cache.
    [ ! -s /root/.ssh/authorized_keys ] || return 0
    [ "$(cat /run/q2/state-status 2>/dev/null)" = ready ] || return 0
    [ -b /dev/mmcblk0p1 ] || return 0
    case "$(readlink -f /sys/class/block/mmcblk0/device 2>/dev/null)" in
        */13490000.mmc/*) ;;
        *) return 0 ;;
    esac
    awk '$1 == "/dev/mmcblk0p1" && $2 == "/mnt/mmc" && ($3 == "vfat" || $3 == "exfat") { found=1 }
         END { exit !found }' /proc/mounts || return 0
    [ ! -L "$key" ] && [ -f "$key" ] && [ -s "$key" ] || return 0
    mkdir -m 700 "$runtime"
    head -c 65537 "$key" > "$runtime/card-input"
    [ "$(wc -c < "$runtime/card-input")" -le 65536 ] || return 0
    # Accept CRLF edited on the host and preserve options, comments and line
    # boundaries. Dropbear alone parses and authenticates the signed key.
    LC_ALL=C sed 's/\r$//' "$runtime/card-input" > "$runtime/authorized_keys"
    rm "$runtime/card-input"
    LC_ALL=C grep -Ev '^[[:space:]]*(#|$)' "$runtime/authorized_keys" |
        LC_ALL=C grep -Eq '(^|[[:blank:]])(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))[[:blank:]]+[A-Za-z0-9+/=]+([[:blank:]]|$)' ||
        return 0
    : > "$runtime/ready"
}

serve() {
    [ -f "$runtime/ready" ] || return 0
    # Internal state remains mounted through normal USB card export.
    awk '$1 ~ /^\/dev\/ubi[0-9]+_[0-9]+$/ && $2 == "/state" && $3 == "ubifs" { found=1 }
         END { exit !found }' /proc/mounts
    [ ! -L "$private" ]
    mkdir -p -m 700 "$private"
    set -- $(LC_ALL=C ls -ldn "$private")
    [ "$1:$3" = 'drwx------:0' ]
    [ ! -L "$identity" ]
    if [ ! -e "$identity" ]; then
        temporary=$(mktemp -d "$private/.new.XXXXXX")
        trap 'rm -rf "$temporary"' EXIT
        /usr/bin/dropbearkey -t ed25519 -f "$temporary/key" > /dev/null 2>&1
        chmod 600 "$temporary/key"
        mv "$temporary/key" "$identity"
        rm -rf "$temporary"
        trap - EXIT
    fi
    [ -f "$identity" ] && [ -s "$identity" ]
    set -- $(LC_ALL=C ls -ldn "$identity")
    [ "$1:$3" = '-rw-------:0' ]
    n=0
    until [ -f /run/q2/diagnostic-usb-ready ]; do
        [ "$n" -lt 50 ] || return 1
        sleep .1
        n=$((n+1))
    done
    # Use the dedicated RAM key directory and only the USB network interface.
    address=$(ip -4 addr show dev usb0 | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2; exit }')
    [ -n "$address" ] || return 1
    exec /usr/sbin/dropbear -F -E -s -g -G root -j -k -D "$runtime" \
        -r "$identity" -l usb0 -p "$address:22" -P "$runtime/dropbear.pid"
}

case "${1:-}" in
    stage) stage ;;
    serve) serve ;;
    *) exit 2 ;;
esac
